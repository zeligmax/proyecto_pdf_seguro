# ============================================================
# File Secure v3.2 - Environment Variables
# Copy this file to .env and customize the values
# ============================================================

# Database Configuration
FILESECURE_DATABASE_URL=postgresql://filesecure:your_password_here@localhost:5432/filesecure_v3
POSTGRES_PASSWORD=your_secure_password_here

# Redis Configuration (optional)
FILESECURE_REDIS_HOST=localhost
FILESECURE_REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# Security
FILESECURE_SECRET_KEY=your_secret_key_here_generate_with_fernet
PDF_SECURE_MASTER_KEY=your_master_encryption_key_here

# Application
FILESECURE_DEBUG=false
FILESECURE_ENV=production

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_EXPIRATION_MINUTES=60

# Elasticsearch (optional)
ELASTICSEARCH_URL=http://localhost:9200

# pgAdmin (optional)
PGADMIN_PASSWORD=admin_password_here

# ============================================================
# How to generate secure keys:
# ============================================================
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Or for a simple random key:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
